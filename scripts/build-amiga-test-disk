#!/usr/bin/env python3
"""Inject a test payload into a copy of a pre-built AmigaOS base HDF."""

from __future__ import annotations

import argparse
import shutil
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "tools"))

from amiga_emulator.disk import (
    extract_archive,
    install_tree,
    prepend_fujinet_resident_loads,
    run_xdf,
    run_xdf_optional,
    startup_command_offset,
    startup_sequence_needs_patch,
    validate_fujinet_resident_load_flags,
)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--base-hdf", type=Path, required=True,
        help="pre-built base HDF (from scripts/amiga-env build); copied then test payload injected",
    )
    parser.add_argument("--app", required=True, type=Path)
    parser.add_argument("--app-name", default="wifitest")
    parser.add_argument("--extra-app-dir", action="append", type=Path, default=[],
                        help="directory of additional executables to install in C:")
    parser.add_argument("--extra-app-file", action="append", type=Path, default=[],
                        help="additional executable to install in C: under its basename")
    parser.add_argument("--install-archive", action="append", type=Path, default=[],
                        help="extract an LHA/archive tree into the disk root")
    parser.add_argument("--disk-device", type=Path,
                        help="native fujinet-disk.device to install in DEVS:")
    parser.add_argument("--nio-device", type=Path,
                        help="native fujinet-nio.device to install in DEVS:")
    parser.add_argument("--resident-loader", type=Path,
                        help="resident module loader to install in C:")
    parser.add_argument("--resident-unloader", type=Path,
                        help="resident module unloader to install in C:")
    parser.add_argument("--load-driver", action="store_true",
                        help="load fujinet-disk.device during startup")
    parser.add_argument("--load-nio", action="store_true",
                        help="load fujinet-nio.device during startup (before disk/app NIO)")
    parser.add_argument("--disk-mount-tool", type=Path,
                        help="fujinet-mount command to install in C:")
    parser.add_argument("--disk-mountlist", action="append", type=Path,
                        default=[], help="DNx MountList entry to install in DEVS:")
    parser.add_argument("--disk-mountlist-target", action="append", nargs=2,
                        metavar=("SOURCE", "TARGET"), default=[],
                        help="MountList source and explicit destination in the image")
    parser.add_argument("--devs-file", action="append", type=Path, default=[],
                        help="extra file to copy into DEVS: under its basename")
    parser.add_argument("--command", default=None,
                        help="startup command; defaults to the installed app name")
    parser.add_argument("--startup-script", type=Path,
                        help="complete Startup-Sequence to install instead of generating one")
    parser.add_argument("--startup-target", default="S/Startup-Sequence",
                        help="guest startup file to replace (default: S/Startup-Sequence)")
    parser.add_argument("--interactive", action="store_true",
                        help="preserve the OS startup sequence for interactive use")
    parser.add_argument("--no-workbench", action="store_true",
                        help="run the startup test in the CLI and stop before LoadWB")
    parser.add_argument("--output", required=True, type=Path)
    args = parser.parse_args()

    if not args.base_hdf.is_file():
        raise SystemExit(f"base HDF not found: {args.base_hdf}")
    if not args.app.is_file():
        raise SystemExit(f"application not found: {args.app}")
    for app_dir in args.extra_app_dir:
        if not app_dir.is_dir():
            raise SystemExit(f"additional Amiga application directory not found: {app_dir}")
    for app_file in args.extra_app_file:
        if not app_file.is_file():
            raise SystemExit(f"additional Amiga application file not found: {app_file}")
    for archive in args.install_archive:
        if not archive.is_file():
            raise SystemExit(f"installation archive not found: {archive}")
    for path, label in ((args.disk_device, "disk device"),
                        (args.nio_device, "nio device"),
                        (args.resident_loader, "resident loader"),
                        (args.resident_unloader, "resident unloader"),
                        (args.disk_mount_tool, "disk mount tool")):
        if path is not None and not path.is_file():
            raise SystemExit(f"{label} not found: {path}")
    if args.load_driver and (args.disk_device is None or args.resident_loader is None):
        raise SystemExit("--load-driver requires --disk-device and --resident-loader")
    if args.load_nio and (args.nio_device is None or args.resident_loader is None):
        raise SystemExit("--load-nio requires --nio-device and --resident-loader")
    validate_fujinet_resident_load_flags(
        load_driver=args.load_driver,
        load_nio=args.load_nio,
    )
    for path in args.disk_mountlist:
        if not path.is_file():
            raise SystemExit(f"disk MountList not found: {path}")
    for source, target in args.disk_mountlist_target:
        if not Path(source).is_file():
            raise SystemExit(f"disk MountList source not found: {source}")
        if not target or target.startswith("/") or ".." in Path(target).parts:
            raise SystemExit(f"invalid disk MountList destination: {target!r}")
    for path in args.devs_file:
        if not path.is_file():
            raise SystemExit(f"DEVS file not found: {path}")

    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.unlink(missing_ok=True)

    with tempfile.TemporaryDirectory(prefix="amiga-test-disk-") as temp:
        shutil.copy2(args.base_hdf, args.output)
        # The base HDF is read-only; the disposable copy must be writable.
        args.output.chmod(0o644)

        # Read the requested startup file. Most environments use the primary
        # Startup-Sequence; WB1.3 media may delegate its early boot work to a
        # second sequence which must run before Workbench.
        startup_target = args.startup_target.strip()
        if not startup_target or startup_target.startswith("/") or ".." in startup_target.split("/"):
            raise SystemExit(f"Invalid startup target: {args.startup_target!r}")
        ss_local = Path(temp) / "startup-target"
        try:
            run_xdf(args.output, "read", startup_target, str(ss_local))
        except SystemExit as exc:
            raise SystemExit(f"Could not read {startup_target} from base HDF") from exc
        staged_startup = ss_local.read_text(encoding="latin-1")

        # Install test payload: app, driver, extra apps, archives.
        run_xdf(args.output, "write", str(args.app), f"C/{args.app_name}")
        if args.disk_device:
            run_xdf(args.output, "write", str(args.disk_device), "Devs/fujinet-disk.device")
        if args.nio_device:
            run_xdf(args.output, "write", str(args.nio_device), "Devs/fujinet-nio.device")
        if args.resident_loader:
            run_xdf(args.output, "write", str(args.resident_loader), "C/fujinet-load-resident")
        if args.resident_unloader:
            run_xdf(args.output, "write", str(args.resident_unloader), "C/fujinet-unload-resident")
        if args.disk_mount_tool:
            run_xdf(args.output, "write", str(args.disk_mount_tool), "C/fujinet-mount")
        for mountlist in args.disk_mountlist:
            run_xdf(args.output, "write", str(mountlist), f"Devs/{mountlist.name}")
        for index, (source, target) in enumerate(args.disk_mountlist_target):
            # WB1.3's Mount command reads the shared DEVS:MountList, which
            # already contains essential system devices such as NEWCON:. Add
            # the test device rather than replacing that system file.
            existing = Path(temp) / f"mountlist-existing-{index}"
            merged = Path(temp) / f"mountlist-merged-{index}"
            if run_xdf_optional(args.output, "read", target, str(existing)):
                existing_bytes = existing.read_bytes()
            else:
                existing_bytes = b""
            source_bytes = Path(source).read_bytes().rstrip(b"\r\n") + b"\n#\n"
            separator = b"" if not existing_bytes or existing_bytes.endswith(b"\n") else b"\n"
            merged.write_bytes(existing_bytes + separator + source_bytes)
            run_xdf_optional(args.output, "delete", target)
            run_xdf(args.output, "write", str(merged), target)
        for devs_file in args.devs_file:
            run_xdf(args.output, "write", str(devs_file), f"Devs/{devs_file.name}")
        installed_names = {args.app_name}
        for app_file in args.extra_app_file:
            if app_file.name in installed_names:
                raise SystemExit(f"duplicate C: application name: {app_file.name}")
            run_xdf(args.output, "write", str(app_file), f"C/{app_file.name}")
            installed_names.add(app_file.name)
        for app_dir in args.extra_app_dir:
            for app in sorted(app_dir.iterdir()):
                if not app.is_file() or app.name in installed_names:
                    continue
                run_xdf(args.output, "write", str(app), f"C/{app.name}")
                installed_names.add(app.name)
        for index, archive in enumerate(args.install_archive):
            archive_root = Path(temp) / f"archive-{index}"
            extract_archive(archive, archive_root)
            install_tree(args.output, archive_root)

        if startup_sequence_needs_patch(
            startup_script=args.startup_script is not None,
            interactive=args.interactive,
            load_driver=args.load_driver,
            load_nio=args.load_nio,
        ):
            if args.startup_script:
                if not args.startup_script.is_file():
                    raise SystemExit(f"startup script not found: {args.startup_script}")
                test_commands = args.startup_script.read_text(encoding="ascii")
            elif args.interactive:
                test_commands = ""
            else:
                command = args.command or args.app_name
                test_commands = (
                    "C:Assign T: RAM:\n"
                    f"C:{command} >DH0:{args.app_name}.result\n"
                )
            test_commands = prepend_fujinet_resident_loads(
                test_commands,
                load_driver=args.load_driver,
                load_nio=args.load_nio,
            )

            if startup_target.lower() == "s/startup-sequence":
                marker_at = startup_command_offset(staged_startup, "LoadWB")
                if marker_at is None:
                    raise SystemExit("licensed Startup-Sequence has no LoadWB command line")
                startup_text = staged_startup[:marker_at] + test_commands.rstrip() + "\n"
                if args.no_workbench:
                    startup_text += "C:Wait 1\nC:EndCLI\n"
                else:
                    startup_text += staged_startup[marker_at:]
            else:
                # A delegated startup such as WB1.3's S:StartupII has no
                # LoadWB marker. Preserve its setup (notably ENV: assigns),
                # then insert the test immediately before its existing Break
                # wakes the primary Startup-Sequence.
                marker_at = startup_command_offset(staged_startup, "Break")
                if marker_at is None:
                    raise SystemExit(
                        f"delegated startup {startup_target} has no Break command line"
                    )
                startup_text = (
                    staged_startup[:marker_at]
                    + test_commands.rstrip()
                    + "\n"
                    + staged_startup[marker_at:]
                )
            startup = Path(temp) / "startup-target-patched"
            startup.write_text(startup_text, encoding="latin-1")
            run_xdf(args.output, "delete", startup_target)
            run_xdf(args.output, "write", str(startup), startup_target)
            # Workbench 1.3 only executes Startup-Sequence files carrying the
            # script protection bit.  xdftool writes new files with its normal
            # data-file protection mask, so restore the standard executable
            # script attributes after replacing a startup file.
            run_xdf(args.output, "protect", startup_target, "s+rwed")

    print(f"Built Amiga test HDF: {args.output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
