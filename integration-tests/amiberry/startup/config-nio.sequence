C:config-nio SCRIPT=RAM:accept.script RESULT=DH0:cfg-accept.result
C:config-nio SCRIPT=RAM:fill.script RESULT=DH0:cfg-fill.result
C:config-nio SCRIPT=RAM:reload.script RESULT=DH0:cfg-reload.result
C:config-nio SCRIPT=RAM:big.script RESULT=DH0:cfg-big.result
C:Dir >NIL: DN0:
C:config-nio SCRIPT=RAM:media.script RESULT=DH0:cfg-media.result
C:fujinet-nio-exchange --type file-list --backend cold --baud 38400 --size 256 --trials 1 --uri host:/amiga-e2e-complete/config-nio
EndIf
